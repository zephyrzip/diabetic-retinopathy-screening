PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/retinaguard
# Optional; when omitted, the patient and report tables use DATABASE_URL.
DOCTOR_DATABASE_URL=
# Use false for a local PostgreSQL server; hosted database providers generally require SSL.
DATABASE_SSL=false
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set to the ONNX model path. Defaults to backend/dr_model.onnx.
DR_MODEL_PATH=
# Set this to python on Windows if python3 is not available.
PYTHON_BIN=python3
